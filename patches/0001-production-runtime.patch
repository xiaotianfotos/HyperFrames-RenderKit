+void HTMLCanvasElement::requestSynchronousPaint() {
+  LocalFrameView* view = GetDocument().View();
+  if (!view) {
+    return;
+  }
+  // HyperFrames offline rendering has no display-vsync dependency. Force the
+  // complete Blink lifecycle to PaintClean and dispatch the canvas paint event
+  // before returning so deterministic frame capture is paced by rendering work,
+  // not by the desktop compositor refresh rate.
+  view->RequestCanvasOnpaint(*this);
+  view->UpdateAllLifecyclePhases(
+      DocumentUpdateReason::kCanvasDrawElementImage);
+  view->RunPostLifecycleSteps();
+}
